// VS Code Launch Configuration for LFAI Development
{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Extension (Development Host)",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}"
      ],
      "outFiles": [
        "${workspaceFolder}/dist/**/*.js"
      ],
      "preLaunchTask": "${defaultBuildTask}",
      "sourceMaps": true
    }
  ]
}
