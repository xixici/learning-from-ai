{
  "name": "lfai",
  "displayName": "LFAI — Learning From AI",
  "description": "从每日代码变更与 AI 交互中提炼核心考点、架构权衡与自测卡片，告别 AI 时代技能空心化。",
  "version": "0.1.0",
  "publisher": "lfai-community",
  "repository": {
    "type": "git",
    "url": "https://github.com/lfai/learning-from-ai"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Education",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "learning",
    "codex",
    "copilot",
    "ai",
    "study",
    "anki",
    "review"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "lfai-sidebar-container",
          "title": "Learning From AI (LFAI)",
          "icon": "resources/brain.svg"
        }
      ]
    },
    "views": {
      "lfai-sidebar-container": [
        {
          "type": "webview",
          "id": "lfai.sidebarView",
          "name": "今日学习复盘 (Daily Digest)"
        }
      ]
    },
    "commands": [
      {
        "command": "lfai.extractTodayLearnings",
        "title": "提炼今日代码与 AI 考点",
        "category": "LFAI",
        "icon": "$(sparkle)"
      },
      {
        "command": "lfai.extractSelection",
        "title": "提炼当前选中代码深度原理",
        "category": "LFAI",
        "icon": "$(book)"
      },
      {
        "command": "lfai.openTodayNote",
        "title": "打开今日学习笔记",
        "category": "LFAI",
        "icon": "$(markdown)"
      },
      {
        "command": "lfai.refreshSidebar",
        "title": "刷新今日学习看板",
        "category": "LFAI",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "lfai.extractSelection",
          "when": "editorHasSelection",
          "group": "LFAI"
        }
      ],
      "view/title": [
        {
          "command": "lfai.extractTodayLearnings",
          "when": "view == lfai.sidebarView",
          "group": "navigation@1"
        },
        {
          "command": "lfai.openTodayNote",
          "when": "view == lfai.sidebarView",
          "group": "navigation@2"
        },
        {
          "command": "lfai.refreshSidebar",
          "when": "view == lfai.sidebarView",
          "group": "navigation@3"
        }
      ]
    },
    "configuration": {
      "title": "Learning From AI (LFAI)",
      "properties": {
        "lfai.llmProvider": {
          "type": "string",
          "default": "vscode.lm",
          "enum": [
            "vscode.lm",
            "custom"
          ],
          "enumDescriptions": [
            "使用 VS Code 语言模型 API (需要 Copilot 订阅或已注册的 LM 插件，零配置 Key)",
            "使用外部 OpenAI/DeepSeek 兼容 API"
          ],
          "description": "LLM 模型提供方"
        },
        "lfai.customApiBaseUrl": {
          "type": "string",
          "default": "https://api.deepseek.com/v1",
          "description": "自定义 LLM 基础 URL（当提供方为 custom 时有效）"
        },
        "lfai.customApiKey": {
          "type": "string",
          "default": "",
          "description": "自定义 LLM API Key"
        },
        "lfai.customModel": {
          "type": "string",
          "default": "deepseek-chat",
          "description": "自定义模型名称（如 deepseek-chat, gpt-4o-mini 等）"
        },
        "lfai.notesDir": {
          "type": "string",
          "default": ".lfai/daily",
          "description": "学习笔记保存目录（相对于工作区根目录）"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "build": "node esbuild.js",
    "package": "node esbuild.js --production",
    "package:vsix": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^2.24.0",
    "esbuild": "^0.23.0",
    "typescript": "^5.4.5"
  }
}
